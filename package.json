{
    "name": "sameko-dev-cpp",
    "version": "1.2.0",
    "description": "A fast, modern, and beautiful C++ IDE built with Electron and Monaco Editor",
    "main": "app/main.js",
    "author": "QuangquyNguyenvo",
    "license": "MIT",
    "homepage": "https://github.com/QuangquyNguyenvo/Sameko-Dev-CPP",
    "repository": {
        "type": "git",
        "url": "https://github.com/QuangquyNguyenvo/Sameko-Dev-CPP.git"
    },
    "bugs": {
        "url": "https://github.com/QuangquyNguyenvo/Sameko-Dev-CPP/issues"
    },
    "keywords": [
        "cpp",
        "c++",
        "c-plus-plus",
        "cpp-ide",
        "c++-ide",
        "ide",
        "code-editor",
        "editor",
        "electron",
        "electron-app",
        "monaco-editor",
        "programming",
        "development",
        "competitive-programming",
        "coding",
        "compiler",
        "gcc",
        "mingw",
        "windows-ide",
        "lightweight-ide",
        "devcpp",
        "dev-cpp",
        "student-ide",
        "beginner-friendly",
        "cpp-compiler",
        "code-runner",
        "syntax-highlighting",
        "intellisense",
        "autocomplete",
        "portable-ide",
        "theme-customization",
        "kawaii",
        "educational-software",
        "programming-tools",
        "cpp-development",
        "cpp11",
        "cpp14",
        "cpp17",
        "cpp20"
    ],
    "scripts": {
        "start": "electron .",
        "dev": "electron . --enable-logging",
        "clean": "node scripts/clean.js settings",
        "clean-start": "npm run clean && npm start",
        "build": "electron-builder --win nsis portable zip --linux tar.gz",
        "build:win": "electron-builder --win nsis portable zip",
        "build:mac": "electron-builder --mac",
        "build:linux": "electron-builder --linux AppImage deb tar.gz",
        "build:all": "electron-builder --win nsis portable zip --linux AppImage deb tar.gz",
        "clean:dist": "node scripts/clean.js dist",
        "rebuild:win": "npm run clean:dist && npm run build:win",
        "rebuild": "npm run clean:dist && npm run build",
        "codegraph:sync": "codegraph sync",
        "codegraph:status": "codegraph status",
        "test:debugger": "node scripts/test-debugger.js",
        "test:gui": "node scripts/test-gui-smoke.js"
    },
    "dependencies": {
        "discord-rpc": "^4.0.1",
        "electron-log": "^5.4.3",
        "electron-updater": "^6.7.3",
        "golden-layout": "^2.6.0",
        "monaco-editor": "^0.45.0",
        "tree-sitter": "^0.21.1",
        "tree-sitter-cpp": "^0.23.4",
        "v8-compile-cache": "^2.4.0",
        "xterm": "^5.3.0",
        "xterm-addon-fit": "^0.8.0"
    },
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1",
        "playwright-core": "^1.62.0",
        "sharp": "^0.34.5"
    },
    "build": {
        "appId": "com.quangquy.cppide",
        "productName": "Sameko Dev C++",
        "artifactName": "${productName}-${version}.${ext}",
        "directories": {
            "output": "samekodevcpp"
        },
        "files": [
            "app/**/*",
            "preload.js",
            "shared/**/*",
            "src/**/*",
            "node_modules/**/*",
            "!Sameko-GCC/**/*",
            "!node_modules/monaco-editor/dev/**",
            "!node_modules/monaco-editor/esm/**",
            "!node_modules/monaco-editor/min-maps/**",
            "!node_modules/monaco-editor/*.d.ts",
            "!node_modules/monaco-editor/CHANGELOG.md",
            "!node_modules/monaco-editor/ThirdPartyNotices.txt",
            "!node_modules/tree-sitter-cpp/src/**",
            "!node_modules/tree-sitter-cpp/*.wasm",
            "!node_modules/tree-sitter-c/src/**",
            "!node_modules/tree-sitter-c/*.wasm",
            "!node_modules/tree-sitter/prebuilds/**",
            "node_modules/tree-sitter/prebuilds/${platform}-${arch}/**",
            "!node_modules/tree-sitter-cpp/prebuilds/**",
            "node_modules/tree-sitter-cpp/prebuilds/${platform}-${arch}/**",
            "!node_modules/tree-sitter-c/prebuilds/**",
            "node_modules/tree-sitter-c/prebuilds/${platform}-${arch}/**",
            "!plans/**",
            "!docs/**",
            "!scripts/**",
            "!.agent/**",
            "!.github/**",
            "!.claudeprompt",
            "!CLAUDE.md",
            "!CODEBASE.md",
            "!PLANNING.md",
            "!CONTRIBUTING.md",
            "!CHANGELOG.md",
            "!setup-bundled-mingw.md",
            "!build-local.ps1",
            "!compile_error.log",
            "!compile_flags.txt",
            "!NUL.exe",
            "!**/*.js.map",
            "!**/*.ts.map",
            "!**/*.css.map"
        ],
        "asar": true,
        "npmRebuild": false,
        "publish": [
            {
                "provider": "github",
                "owner": "QuangquyNguyenvo",
                "repo": "Sameko-Dev-CPP",
                "releaseType": "release"
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "src/assets/icon.ico",
            "publisherName": "Sameko Project",
            "artifactName": "sameko-dev-cpp-${version}-portable.${ext}",
            "verifyUpdateCodeSignature": false,
            "signDlls": false,
            "signExts": [],
            "extraResources": [
                {
                    "from": "Sameko-GCC",
                    "to": "Sameko-GCC",
                    "filter": [
                        "**/*"
                    ]
                }
            ]
        },
        "nsis": {
            "artifactName": "sameko-dev-cpp-setup-${version}.${ext}",
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Sameko Dev C++",
            "perMachine": false,
            "allowElevation": true
        },
        "portable": {
            "artifactName": "sameko-dev-cpp-${version}-portable.${ext}"
        },
        "mac": {
            "target": "dmg",
            "icon": "src/assets/icon.icns"
        },
        "linux": {
            "target": [
                "AppImage",
                "deb",
                "tar.gz"
            ],
            "artifactName": "sameko-dev-cpp-${version}-linux-${arch}.${ext}",
            "icon": "src/assets/icons/linux",
            "category": "Development",
            "synopsis": "A fast, modern C++ IDE",
            "maintainer": "QuangquyNguyenvo <QuangquyNguyenvo@users.noreply.github.com>",
            "desktop": {
                "Name": "Sameko Dev C++",
                "Comment": "A fast, modern C++ IDE",
                "Categories": "Development;IDE;",
                "StartupWMClass": "Sameko Dev C++"
            }
        },
        "deb": {
            "recommends": [
                "g++",
                "gdb",
                "clangd",
                "astyle"
            ]
        }
    }
}
