{
    "name": "sameko-dev-cpp",
    "version": "1.3.1",
    "description": "A fast, modern, and beautiful C++ IDE built with Electron and Monaco Editor",
    "main": "app/main.js",
    "author": "QuangquyNguyenvo",
    "license": "MIT",
    "homepage": "https://sameko.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/QuangquyNguyenvo/Sameko-Dev-CPP.git"
    },
    "bugs": {
        "url": "https://github.com/QuangquyNguyenvo/Sameko-Dev-CPP/issues"
    },
    "keywords": [
        "cpp",
        "c++",
        "c-plus-plus",
        "cpp-ide",
        "c++-ide",
        "ide",
        "code-editor",
        "editor",
        "electron",
        "electron-app",
        "monaco-editor",
        "programming",
        "development",
        "competitive-programming",
        "coding",
        "compiler",
        "gcc",
        "mingw",
        "windows-ide",
        "lightweight-ide",
        "devcpp",
        "dev-cpp",
        "student-ide",
        "beginner-friendly",
        "cpp-compiler",
        "code-runner",
        "syntax-highlighting",
        "intellisense",
        "autocomplete",
        "portable-ide",
        "theme-customization",
        "kawaii",
        "educational-software",
        "programming-tools",
        "cpp-development",
        "cpp11",
        "cpp14",
        "cpp17",
        "cpp20"
    ],
    "scripts": {
        "start": "electron .",
        "dev": "electron . --enable-logging",
        "clean": "node scripts/clean.js settings",
        "clean-start": "npm run clean && npm start",
        "build": "npm run build:win && npm run build:appimage",
        "build:win": "electron-builder --win nsis zip && node scripts/build-setup.js",
        "build:appimage": "node scripts/build-appimage.js",
        "build:mac": "electron-builder --mac",
        "build:linux": "electron-builder --linux AppImage deb tar.gz -c.productName=Sameko-Dev-CPP",
        "build:all": "npm run build:win && electron-builder --linux AppImage deb tar.gz -c.productName=Sameko-Dev-CPP",
        "clean:dist": "node scripts/clean.js dist",
        "rebuild:win": "npm run clean:dist && npm run build:win",
        "rebuild": "npm run clean:dist && npm run build",
        "icons": "node scripts/build-icons.js",
        "codegraph:sync": "codegraph sync",
        "codegraph:status": "codegraph status",
        "test:debugger": "node scripts/test-debugger.js",
        "test:gui": "node scripts/test-gui-smoke.js",
        "test:themes": "node scripts/test-theme-customizer-gui.js"
    },
    "dependencies": {
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "discord-rpc": "^4.0.1",
        "electron-log": "^5.4.4",
        "electron-updater": "^6.8.9",
        "gsap": "^3.15.0",
        "monaco-editor": "^0.45.0",
        "v8-compile-cache": "^2.4.0"
    },
    "devDependencies": {
        "@phosphor-icons/core": "^2.1.1",
        "electron": "^44.5.1",
        "electron-builder": "^26.15.3",
        "playwright-core": "^1.63.0",
        "sharp": "^0.35.5"
    },
    "build": {
        "appId": "com.quangquy.cppide",
        "productName": "Sameko Dev C++",
        "artifactName": "${productName}-${version}.${ext}",
        "directories": {
            "output": "samekodevcpp"
        },
        "files": [
            "app/**/*",
            "preload.js",
            "shared/**/*",
            "src/**/*",
            "node_modules/**/*",
            "!Sameko-GCC/**/*",
            "!node_modules/monaco-editor/dev/**",
            "!node_modules/monaco-editor/esm/**",
            "!node_modules/monaco-editor/min-maps/**",
            "!node_modules/monaco-editor/*.d.ts",
            "!node_modules/monaco-editor/CHANGELOG.md",
            "!node_modules/monaco-editor/ThirdPartyNotices.txt",
            "!node_modules/monaco-editor/min/vs/language/{typescript,css,html}/**",
            "!node_modules/monaco-editor/min/vs/**/*.nls.{de,es,fr,it,ja,ko,ru,zh-cn,zh-tw}.js",
            "!node_modules/@xterm/{xterm,addon-fit}/{src,typings}/**",
            "!node_modules/gsap/{src,types,utils}/**",
            "!node_modules/gsap/*.{js,md}",
            "!node_modules/gsap/dist/!(gsap.min.js)",
            "!node_modules/js-yaml/dist/**",
            "!src/assets/screenshots/**",
            "!src/assets/icons/icon.png",
            "!src/assets/icons/fish.png",
            "!src/assets/icons/linux/{512x512,1024x1024}.png",
            "!plans/**",
            "!docs/**",
            "!scripts/**",
            "!.github/**",
            "!CLAUDE.md",
            "!AGENTS.md",
            "!CODEBASE.md",
            "!PLANNING.md",
            "!CONTRIBUTING.md",
            "!CHANGELOG.md",
            "!setup-bundled-mingw.md",
            "!compile_error.log",
            "!compile_flags.txt",
            "!**/*.js.map",
            "!**/*.ts.map",
            "!**/*.css.map"
        ],
        "asar": true,
        "npmRebuild": false,
        "electronLanguages": [
            "en-US"
        ],
        "publish": [
            {
                "provider": "github",
                "owner": "QuangquyNguyenvo",
                "repo": "Sameko-Dev-CPP",
                "releaseType": "release"
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "src/assets/icon.ico",
            "signtoolOptions": {
                "publisherName": "Sameko Project"
            },
            "artifactName": "sameko-dev-cpp-${version}-portable.${ext}",
            "verifyUpdateCodeSignature": false,
            "signExts": [],
            "extraResources": [
                {
                    "from": "Sameko-GCC",
                    "to": "Sameko-GCC",
                    "filter": [
                        "**/*",
                        "!bin/ld.lld.exe",
                        "!bin/{gfortran,x86_64-w64-mingw32-*,ccache,ctags,readtags,optscript,nasm,ndisasm,yasm,vsyasm,ytasm,jwasm,ninja,premake5,cmcldeps,sarif-replay,pkgconf,dos2unix,unix2dos,mac2unix,unix2mac,ntldd,listpedeps,copypedeps,bomtool,wl-*}.exe",
                        "!bin/{blake3,crossrun,libarchive-13,libavl,libb2-1,libbrotlicommon,libbrotlidec,libbrotlienc,libbz2,libcrypto-3-x64,libcurl-4,libdirtrav,libfmt,libgcrypt-20,libgdiagnostics-0,libgfortran-5,libgnutls-30,libgomp-plugin-nvptx-1,libgpg-error-0,libgss-3,libgumbo-3,libhiredis,libhogweed-6,libidn2-0,libisl-23,libjansson,liblz4,liblzo2-2,libmpc-3,libnettle-8,libpcre-1,libpcre2-8-0,libpcre2_finder,libpkgconf-7,libpsl-5,librhash,libscalednum,libspdlog,libsqlite3-0,libssh2-1,libtasn1-6,libtss2-esys-0,libtss2-mu-0,libtss2-sys-1,libunistring-5,libuv-1,libxdiff,libxml2-16,libyaml,libzip,lua54,miniargv,pedeps,portcolcon,versioncmp}.dll",
                        "!libexec/gcc/*/*/{f951,cc1obj,cc1objplus}.exe",
                        "!lib/{libgfortran*,libpython3*.a,libyasm.a,libgdiagnostics.dll.a,libgomp-plugin-nvptx.dll.a}",
                        "!lib/gcc/*/*/{finclude,plugin}/**",
                        "!lib/gcc/*/*/libcaf_*.a",
                        "!lib/python3*/{test,idlelib,tkinter,turtledemo,ensurepip,lib2to3,pydoc_data}/**",
                        "!x86_64-w64-mingw32/[0-9]*/**",
                        "!include/{libyasm,python3*}/**",
                        "!**/*.idl",
                        "!share/man/**"
                    ]
                }
            ]
        },
        "nsis": {
            "artifactName": "sameko-dev-cpp-setup-${version}.${ext}",
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Sameko Dev C++",
            "perMachine": false,
            "allowElevation": true,
            "include": "installer/installer.nsh",
            "installerSidebar": "installer/sidebar.bmp",
            "uninstallerSidebar": "installer/sidebar.bmp",
            "installerHeader": "installer/header.bmp",
            "runAfterFinish": true
        },
        "mac": {
            "target": "dmg",
            "icon": "src/assets/icon.icns"
        },
        "linux": {
            "target": [
                "AppImage",
                "deb",
                "tar.gz"
            ],
            "artifactName": "sameko-dev-cpp-${version}-linux-${arch}.${ext}",
            "icon": "src/assets/icons/linux",
            "category": "Development",
            "synopsis": "A fast, modern C++ IDE",
            "maintainer": "QuangquyNguyenvo <QuangquyNguyenvo@users.noreply.github.com>",
            "desktop": {
                "entry": {
                    "Name": "Sameko Dev C++",
                    "Comment": "A fast, modern C++ IDE",
                    "Categories": "Development;IDE;",
                    "StartupWMClass": "Sameko Dev C++"
                }
            }
        },
        "deb": {
            "recommends": [
                "g++",
                "gdb",
                "clangd",
                "astyle"
            ]
        }
    }
}
