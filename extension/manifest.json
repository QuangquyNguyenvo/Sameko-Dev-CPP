{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://codeforces.com/*",
    "https://m1.codeforces.com/*",
    "https://m2.codeforces.com/*",
    "https://m3.codeforces.com/*",
    "https://atcoder.jp/*",
    "https://cses.fi/*",
    "https://oj.vnoi.info/*",
    "https://lqdoj.edu.vn/*",
    "https://dmoj.ca/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/*",
        "https://m1.codeforces.com/*",
        "https://m2.codeforces.com/*",
        "https://m3.codeforces.com/*",
        "https://atcoder.jp/*",
        "https://cses.fi/*",
        "https://oj.vnoi.info/*",
        "https://lqdoj.edu.vn/*",
        "https://dmoj.ca/*"
      ],
      "js": [
        "shared/adapters.js",
        "adapters/codeforces.js",
        "adapters/atcoder.js",
        "adapters/cses.js",
        "adapters/dmoj.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_extActionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
